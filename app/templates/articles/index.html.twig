{% extends 'base.html.twig' %}

{% block title %}Hello ArticlesController!{% endblock %}

{% block body %}


<div class="flex flex-col items-center">
    <div id="search-bar" class="rounded-3xl w-full py-2 px-3 flex gap-2 items-center border border-gray-200 bg-white ">
        <p>🔎</p>
        <input type="text" placeholder="Rechercher un article ..." class="search-bar-input w-full ">

    </div>

{#    <div class="p-10">#}
{#        <ul class="flex gap-3">#}
{#            {% for theme in themes %}#}
{#                <li class="tag-theme" id="filter-theme-{{ theme.id }}">#}
{#                    {{ theme.label }}#}
{#                </li>#}
{#            {% endfor %}#}
{#        </ul>#}
{#    </div>#}

    {% if is_granted('ROLE_REDACTOR') %}
        <div class="my-5 self-stretch md:self-end">
            <button class="btn btn-primary large w-full">Rédiger un nouvel article</button>
        </div>
    {% endif %}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 md:gap-5">
        {% for article in articles %}
            <div class="group flex flex-col gap-5 rounded-xl shadow bg-white overflow-hidden
            transition-[transform,box-shadow,translate] cursor-pointer hover:shadow-lg hover:-translate-y-0.5" >
                <div class="h-[200px] overflow-hidden">
                    <img class="object-contain -mt-10 object-center transition-transform duration-300 group-hover:scale-102" src="{{ asset('/images/articles/' ~ article.image) }}" alt="" height="150">
                </div>
                <article class="p-5">
                    <h2 class="text-2xl font-bold">{{ article.title }}</h2>
                    <p class="text-sm text-gray-400 font-semibold">Ecrit par {{ article.getUser().username }}</p>
                    <div class="article-content pt-5">
                        <p>blabla</p>
                    </div>
                </article>
            </div>
        {% endfor %}
    </div>
</div>

{% endblock %}
