{% extends 'base.html.twig' %}

{% block title %}Hello ArticlesController!{% endblock %}

{% block body %}

<h1 class="text-center text-3xl font-bold mb-10">
    Toute l'actu dev en 1 click();
</h1>
<div class="flex flex-col items-center gap-5 " data-controller="article-search">

    <div id="search-bar" class="rounded-2xl w-full py-2 px-3 flex gap-2 items-center border border-gray-200 bg-white ">
        <i class="fa-solid fa-magnifying-glass text-gray-500 -mt-0.5"></i>
        <input type="text" placeholder="Rechercher un article ..." class="search-bar-input"  data-action="input->article-search#search" data-article-search-target="input">

    </div>

    {% if is_granted('ROLE_REDACTOR') %}
        <div class="my-5 self-stretch md:self-end">
            <a class="btn btn-primary large w-full inline-block text-center" href="{{ path("app_articles_add") }}">Rédiger un nouvel article</a>
        </div>
    {% endif %}



    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 md:gap-5" id="articles-list" data-article-search-target="list">
        {% include 'articles/partials/_articles.html.twig' %}
    </div>
</div>

{% endblock %}
