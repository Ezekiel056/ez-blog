{% extends 'base.html.twig' %}

{% block title %}Hello ArticlesController!{% endblock %}

{% block body %}

<h1 class="text-center text-3xl font-bold mb-10">
    Toute l'actu dev en 1 click();
</h1>
<div class="flex flex-col items-center gap-5">
    <div id="search-bar" class="rounded-2xl w-full py-2 px-3 flex gap-2 items-center border border-gray-200 bg-white ">
        <i class="fa-solid fa-magnifying-glass text-gray-500 -mt-0.5"></i>
        <input type="text" placeholder="Rechercher un article ..." class="search-bar-input">

    </div>

    {% if is_granted('ROLE_REDACTOR') %}
        <div class="my-5 self-stretch md:self-end">
            <a class="btn btn-primary large w-full" href="{{ path("app_articles_add") }}">Rédiger un nouvel article</a>
        </div>
    {% endif %}

    <div class="flex justify-center border items-center p-5 rounded-2xl border-gray-200 w-full bg-white">
        <h2 class="text-center text-xl font-semibold">Les derniers articles ajoutés</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 md:gap-5">
        {% for article in articles %}
            <a class="group flex flex-col gap-5 rounded-xl shadow bg-white overflow-hidden
            transition-[transform,box-shadow,translate] cursor-pointer hover:shadow-lg hover:-translate-y-0.5 text-black no-underline" href="{{ path('app_articles_show',{id:article.id}) }}" >
                <div class="h-[200px] overflow-hidden">
                    <img class="object-contain -mt-10 object-center transition-transform duration-300 group-hover:scale-102" src="{{ asset('/images/articles/' ~ article.image) }}" alt="" height="150">
                </div>
                <article class="flex flex-col gap-3 p-5">
                    <h2 class="text-2xl font-bold">{{ article.title }}</h2>
                    <p class="text-sm text-gray-400">Ecrit par {{ article.getUser().username }} - Le {{ article.getCreatedAt() | date('d/m/y')}}</p>
                    <p class="pt-5">{{ article.getResume() }}</p>
                </article>
            </a>
        {% endfor %}
    </div>
</div>

{% endblock %}
