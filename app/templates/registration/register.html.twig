{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}

<div class="bg-white p-10 shadow-2xl rounded-lg md:w-3xl md:self-center" >

    {{ form_errors(registrationForm) }}

    {{ form_start(registrationForm,{'attr':{'class':'flex flex-col gap-4 md:gap-6'}}) }}
        <h1 class="mb-3 text-xl">S'enregistrer</h1>

        {{ form_row(registrationForm.username) }}
        {{ form_row(registrationForm.email) }}
        {{ form_row(registrationForm.plainPassword) }}
        {{ form_row(registrationForm.repeatPlainPassword) }}

        <div class="flex gap-3 items-center">
            {{ form_widget(registrationForm.agreeTerms) }}
            {{ form_label(registrationForm.agreeTerms) }}
            {{ form_errors(registrationForm.agreeTerms) }}

        </div>

        {{ form_rest(registrationForm) }}

        <button type="submit" class="btn">Valilder</button>
        <p class="text-neutral-700">Vous avez déjà un compte? <a  href="{{ path("app_login") }}">Se connecter</a></p>

    {{ form_end(registrationForm) }}
</div>
{% endblock %}
