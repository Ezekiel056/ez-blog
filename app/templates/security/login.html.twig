{% extends 'base.html.twig' %}

{% block title %}Se connecter{% endblock %}

{% block body %}
    <div class="bg-white p-10 shadow-2xl rounded-lg md:w-3xl md:self-center" >
        <form class="flex flex-col gap-4 md:gap-6" method="post">


            <h1 class="mb-3 text-xl" >Se connecter</h1>
            <div class="labeled-input">
                <label for="username">Nom d'utilisateur</label>
                <input type="text" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="username" required autofocus>
            </div>

            <div class="labeled-input">
                <label for="password">Mot de passe</label>
                <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
            </div>



            <div class="flex items-center gap-3">
                <input  type="checkbox" name="_remember_me" id="_remember_me">
                <label for="_remember_me">Se souvenir de moi</label>
            </div>
            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

            <button class="mt-5 btn btn-primary large" type="submit">
                Se connecter
            </button>
            {% if error %}
                <div class="text-red-800 text-center">Connexion refusée. Veuillez vérifier votre saisie</div>
            {% endif %}

            <p class="text-neutral-700">Vous n'avez pas de compte? <a  href="{{ path("app_register") }}">S'enregistrer</a></p>


        </form>
    </div>
{% endblock %}
